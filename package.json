    "url": "https://github.com/snowch/postgresql-lab/issues"
  },
  "homepage": "https://github.com/snowch/postgresql-lab#readme",
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "vite": "8.3.6"
  },
  "private": true
