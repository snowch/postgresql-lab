{
  "name": "postgresql-lab",
  "version": "1.0.0",
  "description": "An advanced, hands-on PostgreSQL book with browser-native WASM investigations",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && vite preview --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run build && node tests/content.mjs && node --test tests/sql.test.mjs",
    "test:browser": "playwright test",
    "test:server": "node tests/server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowch/postgresql-lab.git"
  },
